{
  "rules": {
    "casamento": {

      "confirmacoes": {
        ".read": "auth != null",
        "$familia": {
          ".write": "newData.exists() || auth != null",
          ".validate": "newData.hasChildren(['familia', 'respondidoPor', 'pessoas', 'atualizadoEm'])",
          "familia":       { ".validate": "newData.isString() && newData.val() === $familia" },
          "respondidoPor": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
          "telefone":      { ".validate": "newData.isString() && newData.val().length <= 40" },
          "restricao":     { ".validate": "newData.isString() && newData.val().length <= 400" },
          "mensagem":      { ".validate": "newData.isString() && newData.val().length <= 600" },
          "atualizadoEm":  { ".validate": "newData.isNumber()" },
          "pessoas": {
            ".validate": "newData.hasChildren()",
            "$indice": {
              ".validate": "newData.hasChildren(['nome', 'vai'])",
              "nome": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "vai":     { ".validate": "newData.isBoolean()" },
              "crianca": { ".validate": "newData.isBoolean()" },
              "$outro": { ".validate": false }
            }
          },
          "$outro": { ".validate": false }
        }
      },

      "config": {
        ".read": true,
        ".write": "auth != null",
        "pix": {
          "chave":         { ".validate": "newData.isString() && newData.val().length <= 120" },
          "nomeRecebedor": { ".validate": "newData.isString() && newData.val().length <= 25" },
          "cidade":        { ".validate": "newData.isString() && newData.val().length <= 15" },
          "qrProprio":     { ".validate": "newData.isString() && newData.val().length <= 400000" },
          "$outro": { ".validate": false }
        },
        "$outro": { ".validate": false }
      },

      "familias": {
        ".read": true,
        "$familia": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['pessoas'])",
          "rotulo": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "ordem":  { ".validate": "newData.isNumber()" },
          "pessoas": {
            ".validate": "newData.hasChildren()",
            "$indice": {
              ".validate": "newData.hasChildren(['nome'])",
              "nome":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "crianca": { ".validate": "newData.isBoolean()" },
              "apelidos": { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
              "$outro": { ".validate": false }
            }
          },
          "$outro": { ".validate": false }
        }
      },

      "catalogo": {
        ".read": true,
        "$item": {
          ".write": "auth != null",
          "nome":      { ".validate": "newData.isString() && newData.val().length <= 120" },
          "valor":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "categoria": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "descricao": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "imagem":    { ".validate": "newData.isString() && newData.val().length <= 600" },
          "ordem":     { ".validate": "newData.isNumber()" },
          "cotas":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "ativo":     { ".validate": "newData.isBoolean()" },
          "$outro": { ".validate": false }
        }
      },

      "imagens": {
        ".read": true,
        "$item": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 400000"
        }
      },

      "presentes": {
        ".read": true,
        "$item": {
          "$contribuicao": {
            ".write": "(!data.exists() && newData.exists() && newData.child('pago').val() === false) || auth != null",
            ".validate": "newData.hasChildren(['presente', 'nome', 'valor'])",
            "presente":    { ".validate": "newData.isString() && newData.val().length <= 120" },
            "nome":        { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
            "valor":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "cotas":       { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
            "mensagem":    { ".validate": "newData.isString() && newData.val().length <= 300" },
            "pago":        { ".validate": "newData.isBoolean()" },
            "reservadoEm": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          }
        }
      },

      "recados": {
        ".read": true,
        ".indexOn": ["criadoEm"],
        "$recado": {
          ".write": "(!data.exists() && newData.exists() && newData.child('aprovado').val() === false) || auth != null",
          ".validate": "newData.hasChildren(['nome', 'mensagem', 'criadoEm'])",
          "nome":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
          "mensagem": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 300" },
          "aprovado": { ".validate": "newData.isBoolean()" },
          "criadoEm": { ".validate": "newData.isNumber()" },
          "$outro": { ".validate": false }
        }
      }
    }
  }
}
